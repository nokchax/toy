# cp .env.example .env 후 값을 채운다. .env 는 커밋하지 않는다.
# - 로컬: 프로젝트 루트의 .env 를 앱이 직접 읽는다 (./gradlew :<앱>:bootRun)
# - 네 앱(bot, crawler, internal, external)이 이 파일 하나를 함께 쓴다
# - NAS: /volume2/docker/apps/toy/.env (chmod 600). docker compose 가 읽어서 환경변수로 넣는다

# NAS 에서는 dev. 로컬에서는 이 줄을 지우거나 local 로 둔다
SPRING_PROFILES_ACTIVE=dev

# @BotFather 에서 받은 토큰
TOY_TELEGRAM_TOKEN=
# 봇을 쓸 수 있는 chat id (쉼표 구분). 비워두고 봇에 /help 를 보내면 내 chat id 를 알려준다
TOY_TELEGRAM_ALLOWED_CHAT_IDS=

# NAS 에서 띄울 때만 필요 (dev/prod 프로필). 로컬(local 프로필)은 H2 를 쓰므로 비워둬도 된다
DB_URL=jdbc:mysql://<NAS IP>:3306/<DB 이름>?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=
DB_PASSWORD=

# 브라우저로 가져오기(-fetch browser)용 원격 브라우저 주소. NAS 에서는 compose 가 http://browser:4444 로 넣어 준다
# 로컬: docker compose up -d browser 후 아래 주석을 푼다. 비어 있으면 browser 로 등록한 크롤만 실패한다
# TOY_CRAWL_BROWSER_URL=http://localhost:4444

# 인터널 · 익스터널이 다루는 크롤의 주인 chat id (봇에서 쓰는 내 chat id 와 같게)
TOY_OWNER_CHAT_ID=

# 인터널(8090)을 열 주소. 비우면 127.0.0.1 (NAS 안에서만). NAS 의 내부망 IP 를 넣으면 집 안 네트워크에서 붙는다
# (compose 가 읽는 값이라 docker compose --env-file 로 넘겨야 한다. 배포 워크플로가 그렇게 한다)
TOY_INTERNAL_BIND_IP=

# 인터널 REST API · MCP 키. 비어 있으면 /health 외 모든 요청을 거부한다 (예: openssl rand -hex 32)
TOY_INTERNAL_API_KEY=

# 익스터널 웹 페이지 로그인 계정. 비어 있으면 익스터널 앱이 뜨지 않는다 (공개 페이지라 로그인 필수)
TOY_EXTERNAL_USERNAME=
TOY_EXTERNAL_PASSWORD=
